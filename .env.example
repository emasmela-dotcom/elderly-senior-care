# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth — required in production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Demo login: any email + this password (default: demo)
AUTH_DEMO_PASSWORD="demo"

# Optional: Resend (https://resend.com) for medication / incident emails
# Support form at /support uses the same keys.
# With onboarding@resend.dev you can only send TO your Resend account email until
# you verify a domain — then set RESEND_FROM_EMAIL to e.g. CareConnect <support@yourdomain.com>
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CareConnect <onboarding@resend.dev>"
NOTIFY_TO_EMAIL="apputilitybuilder@gmail.com"

# Optional: tap-to-call number in footer ("Call for help" next to Support)
# Example: +15551234567
NEXT_PUBLIC_SUPPORT_PHONE=""

# ── Google Calendar Sync (Phase 1) ──────────────────────────────────────────
# Setup steps:
#   1. Go to https://console.cloud.google.com/
#   2. Create or select a project
#   3. APIs & Services → Enable APIs → search "Google Calendar API" → Enable
#   4. APIs & Services → OAuth consent screen
#        → External → fill App name / support email → Save
#        → Scopes → Add: .../auth/calendar.readonly → Save
#        → Test users → add your Google account email → Save
#   5. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#        → Application type: Web application
#        → Authorized redirect URIs — add BOTH:
#             http://localhost:3000/api/sync/google-calendar/callback
#             https://www.careconnect-24-7.com/api/sync/google-calendar/callback
#   6. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Phase 2 (not yet implemented — add when building) ───────────────────────
# Microsoft / Outlook
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID="common"

# Epic MyChart (SMART on FHIR — register at https://fhir.epic.com/)
# EPIC_CLIENT_ID=""
