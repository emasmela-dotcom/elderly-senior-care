# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth — required in production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Demo login: any email + this password (default: demo)
AUTH_DEMO_PASSWORD="demo"

# Optional: Resend (https://resend.com) for medication / incident emails
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CareConnect <onboarding@resend.dev>"
NOTIFY_TO_EMAIL="you@example.com"
